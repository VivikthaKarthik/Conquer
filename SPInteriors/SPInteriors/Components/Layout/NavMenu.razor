@using SPInteriors.Authentication
@using SPInteriors.Services.Implementations
@using SPInteriors.Services.Interfaces
@using SPInteriors.Utilities

@rendermode @(new InteractiveServerRenderMode(prerender:false))

<!-- Header Start !-->
<header class="header-area style-4 noPrint">
    <div class="header-menu-area sticky-header">
        <div class="container">
            <div class="row">
                <div class="col-xl-3 col-lg-3 col-md-6 col-6 d-flex align-items-center">
                    <div class="logo-wrapper">
                        <div class="logo">
                            <a href="/" class="standard-logo">
                                <img src="images/logo/black-logo.png" alt="logo" />
                            </a>
                            <a href="/" class="sticky-logo">
                                <img src="images/logo/sticky-logo.png" alt="logo" />
                            </a>
                        </div>
                    </div>
                </div>
                <div class="col-xl-9 col-lg-9 col-md-6 col-6 d-flex align-items-center justify-content-end">
                    <div class="menu d-inline-block">
                        <nav id="main-menu" class="main-menu">
                            <ul>
                                <li class="@(currentPage == "home" ? "active" : "")"><a href="/" @onclick='(() => HandleNavClick("home"))'>Home</a></li>

                                <li class='@(currentPage == "explore" ? "active" : "")'><a href="explore" @onclick='(() => HandleNavClick("explore"))'>Explore</a></li>

                                <CascadingAuthenticationState>
                                    <AuthorizeView>
                                        <Authorized>
                                            @* <li><a href="dashboard" @onclick='(() => HandleNavClick("dashboard"))'>Dashboard</a></li> *@
                                            <li class='@(currentPage == "projects" ? "active" : "")'><a href="projects" @onclick='(() => HandleNavClick("projects"))'>Projects</a></li>
                                            <li class='@(currentPage == "portfolio" ? "active" : "")'><a href="portfolio" class="active" @onclick='(() => HandleNavClick("portfolio"))'>Portfolio</a></li>
                                            <li class='dropdown @(currentPage == "masterdata" ? "active" : "")'>
                                                <a href="javascript:void(0);">Manage</a>
                                                <ul class="submenu">
                                                    <li><a href="masterdata" @onclick='(() => HandleNavClick("masterdata"))'>MasterData</a></li>
                                                    <li><a href="accounts" @onclick='(() => HandleNavClick("accounts"))'>Accounts</a></li>
                                                    <li><a href="inventory" @onclick='(() => HandleNavClick("inventory"))'>Inventory</a></li>
                                                </ul>
                                            </li>
                                        </Authorized>
                                    </AuthorizeView>
                                </CascadingAuthenticationState>
                                <li class='@(currentPage == "aboutus" ? "active" : "")'><a href="portfolio" @onclick='(() => HandleNavClick("aboutus"))'>About Us</a></li>
                                <li class='@(currentPage == "contactus" ? "active" : "")'><a href="portfolio" @onclick='(() => HandleNavClick("contactus"))'>Contact Us</a></li>
                            </ul>
                        </nav>
                    </div>
                    <div class="search-btn-with-btn">
                        @*  <div class="search-btn-wrapper">
                        <a href="javascript:void(0);" class="search-btn">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        </a>
                        </div> *@
                        <CascadingAuthenticationState>
                            <AuthorizeView>
                                <NotAuthorized>
                                    <div class="btn-wrapper">
                                        <a href="javascript:void(0);" @onclick='(() => Login())' class="theme-btn">Login<i class="fa-solid fa-sign-in"></i></a>
                                    </div>
                                </NotAuthorized>
                                <Authorized>

                                    <div class="btn-wrapper">
                                        <a href="javascript:void(0);" @onclick='(() => Logout())' class="theme-btn">Logout<i class="fa-solid fa-sign-in"></i></a>
                                    </div>
                                </Authorized>
                            </AuthorizeView>
                        </CascadingAuthenticationState>
                    </div>
                    <!-- Mobile Menu Toggle Button Start !-->
                    <div class="mobile-menu-bar d-lg-none text-end">
                        <a href="javascript:void(0);" @onclick="Update" class="mobile-menu-toggle-btn"><i class="fal fa-bars"></i></a>
                    </div>
                    <!-- Mobile Menu Toggle Button End !-->
                </div>
            </div>
        </div>
    </div>
</header>
<!-- Header End !-->
<!-- Menu Sidebar Section Start -->
<div class="menu-sidebar-area">
    <div class="menu-sidebar-wrapper">
        <div class="menu-sidebar-close">
            <button class="menu-sidebar-close-btn" id="menu_sidebar_close_btn">
                <i class="fal fa-times"></i>
            </button>
        </div>
        <div class="menu-sidebar-content">
            <div class="menu-sidebar-logo">
                <a href="index.html">
                    <img src="images/logo/black-logo.png" alt="logo" />
                </a>
            </div>
            <div class="mobile-nav-menu"></div>
            <div class="menu-sidebar-content">
                <div class="menu-sidebar-single-widget">
                    <h5 class="menu-sidebar-title">Contact Info</h5>
                    <div class="header-contact-info">
                        <span>
                            <i class="fa-solid fa-location-dot"></i>
                            20, Bordeshi, New York, US
                        </span>
                        <span>
                            <a href="mailto:hello@technova.com">
                                <i class="fa-regular fa-envelope"></i>
                                hello@technova.com
                            </a>
                        </span>
                        <span>
                            <a href="tel:+123-456-7890">
                                <i class="fa-solid fa-phone"></i>
                                +123-456-7890
                            </a>
                        </span>
                    </div>
                    <div class="social-profile">
                        <a href="#"><i class="fa-brands fa-facebook-f"></i></a>
                        <a href="#"><i class="fa-brands fa-twitter"></i></a>
                        <a href="#"><i class="fa-brands fa-linkedin-in"></i></a>
                        <a href="#"><i class="fa-brands fa-youtube"></i></a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Menu Sidebar Section Start -->
<div class="body-overlay"></div>


@code {
@inject IJSRuntime JSRuntime;
    @inject NavigationManager NavigationManager;
    @inject IUserService UserService;
    @inject AuthenticationStateProvider authStateProvider;
    @inject HeaderService headerService;

    private string currentPage = "Home";

    protected override void OnInitialized()
    {
        currentPage = headerService.CurrentPage;
    }

    private void HandleNavClick(string componentName)
    {
        headerService.CurrentPage = componentName;
        NavigationManager.NavigateTo(componentName, true);
    }

    private void Login()
    {
        NavigationManager.NavigateTo("/login", true);
    }
    private async Task Logout()
    {
        var customAuthStateProvider = (CustomAuthenticationStateProvider)authStateProvider;
        await customAuthStateProvider.UpdateAuthenticationState(null);
        NavigationManager.NavigateTo("/", true);
    }

    private void Update()
    {
        JSRuntime.InvokeVoidAsync("addDynamicComponent");
    }
}
