@page "/masterdata"

@using SPInteriors.Models
@using SPInteriors.Services.Interfaces

@rendermode @(new InteractiveServerRenderMode(prerender:false))


<div class="grid-area style-1 scrollable-area" style="height:auto;padding-bottom:30px;background-image: url(./images/contact/subscribe-bg.jpg)">

    <div class="container edit-screen-container" style="padding-bottom:30px;">

        <div class="row edit-screen-header">
            <div class="col-xl-12">
                <h3>Master Data</h3>
            </div>
        </div>

        @if(clients != null && clients.Count > 0){
            <Grid T="ClientDto" GridName="Clients" data="@clients" OnEdit="HandleEdit"></Grid>
        }

        @if (clients != null && clients.Count > 0)
        {
            <Grid T="ClientDto" GridName="Projects" data="@clients" OnEdit="HandleEdit"></Grid>
        }
    </div>
</div>


@code {
    @inject NavigationManager NavigationManager;
    @inject IClientService clientService;

    List<ClientDto> clients = new List<ClientDto>();

    protected async override void OnInitialized()
    {
        var response = await clientService.GetClientsAsync();

        if (response.IsSuccess)
            clients = (List<ClientDto>)response.Result;
    }

    void HandleEdit(ClientDto item)
    {
        NavigationManager.NavigateTo("client/edit/" + item.Id, true);
    }
}
