@page "/quotations/{projectId}"
@rendermode @(new InteractiveServerRenderMode(prerender:false))


@if (isDataFetchedCompletely)
{
    <div class="page-breadcrumb-area page-bg">
        <div class="page-overlay"></div>
        <div class="container">
            <div class="row">
                <div class="col-md-12">
                    <div class="breadcrumb-wrapper">
                        <div class="page-heading">
                            <h3 class="page-title">Quotation</h3>
                        </div>
                        <div class="breadcrumb-list">
                            <ul>
                                <li><a href="javascript:void(0);" @onclick='((value) => Navigate("/"))'>Home</a></li>
                                <li><a href="javascript:void(0);" @onclick='((value) => Navigate("/Projects"))'>Projects</a></li>
                                <li><a href="javascript:void(0);" @onclick='((value) => Navigate("/Projects/Edit/" + projectId))'>@quotation.Address.ClientName's 3 BHK</a></li>
                                <li><a href="javascript:void(0);">Quotation</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="grid-area style-1 scrollable-area" style="">

        <div class="container edit-screen-container" style="background-color:lightgrey;height:auto;">

            <div class="row">
                <div class="col-xl-12 col-lg-12">
                    <div class="subscribe-form-widget">
                        <form>
                            <div class="row form-row">
                                <div class="faq-area">
                                    <div class="container">
                                        <div class="row form-row">
                                            <h3>Type</h3>
                                        </div>
                                        <div class="row form-row">
                                            <div class="col-xl-1 col-lg-1">
                                                <div class="quotation-form-label">
                                                    Box
                                                </div>
                                            </div>
                                            <div class="col-xl-3 col-lg-3">
                                                <div class="form-field">
                                                    <input type="number" class="form-control" @bind-value="BoxPrice" />
                                                </div>
                                            </div>

                                            <div class="col-xl-1 col-lg-1">
                                                <div class="quotation-form-label">
                                                    Frame
                                                </div>
                                            </div>
                                            <div class="col-xl-3 col-lg-3">
                                                <div class="form-field">
                                                    <input type="number" class="form-control" @bind-value="FramePrice" />
                                                </div>
                                            </div>

                                            <div class="col-xl-1 col-lg-1">
                                                <div class="quotation-form-label">
                                                    Panel
                                                </div>
                                            </div>
                                            <div class="col-xl-3 col-lg-3">
                                                <div class="form-field">
                                                    <input type="number" class="form-control" @bind-value="PanelPrice" />
                                                </div>
                                            </div>

                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="row form-row" style="margin-top:20px;">
                                <div class="col-xl-12 grid-buttons-container">
                                    <button class="myButton text-right" @onclick="Calculate" type="button">Update<i class="fa-solid fa-edit"></i></button>
                                    <button class="myButton text-right" @onclick="GeneratePDF" type="button">Download<i class="fa-solid fa-download"></i></button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="grid-area style-1" style="margin-left:110px;margin-bottom:30px;padding-bottom:50px; background-color:white;width:84%">
                    <div class="quotation-container" id="pdf-content" style="height:auto;">
                        <div class="row">
                            <div class="col-xl-12 col-lg-12" style="align-content:center;width:100%;">
                                <div class="row">
                                    <div>
                                        <h2 style="padding-top:30px;color:red;text-align:center;font-family: ff3;line-height: 0.692871;font-style: normal;font-weight: bold;">
                                            SP INTERIORS
                                        </h2>
                                    </div>
                                </div>
                                <div class="row" style="font-size:14px;text-align:center;margin-left:20px;">
                                    <span>Plot No 608, H.No: 5-58/8,NR's Residency, Manikonda, Hyderabad-500089</span>
                                </div>
                                <div class="row" style="font-size:14px;text-align:center;margin-left:20px;">
                                    <span>9032319899, 8074964370</span>
                                </div>

                                <div class="" style="background-color:red;height:10px;">
                                </div>

                                <div class="row" style="margin-top:20px;margin-bottom:30px;">
                                    <div class="col-xl-6 col-lg-6" style="padding-left:30px;">
                                        <h3 style="color: rgb(127, 96, 0);">Quotation</h3>
                                    </div>
                                    <div class="col-xl-6 col-lg-6" style="padding-top:7px;text-align:right;padding-right:20px;">
                                        <h4 style="color: rgb(127, 96, 0);">Submitted on: @quotation.IssuedDate.ToShortDateString()</h4>
                                    </div>
                                </div>
                                <div class="row" style="margin-left:10px;">
                                    <div class="col-xl-4 col-lg-4">
                                        <h4 style="">Quotation For</h4>
                                    </div>
                                    <div class="col-xl-4 col-lg-4">
                                        <h4 style="">Payable to</h4>
                                    </div>
                                    <div class="col-xl-4 col-lg-4">
                                        <h4 style="">Quotation #</h4>
                                    </div>
                                </div>


                                <div class="row" style="margin-left:10px;">
                                    <div class="col-xl-4 col-lg-4">
                                        <div class="row">
                                            <div class="col-xl-12 col-lg-12">
                                                <span>@quotation.Address.Title @quotation.Address.ClientName</span>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-xl-12 col-lg-12">
                                                <span>@quotation.Address.FirstAddress</span>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-xl-12 col-lg-12">
                                                <span>@quotation.Address.SecondAddress</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xl-4 col-lg-4">
                                        <div class="row">
                                            <div class="col-xl-12 col-lg-12">
                                                <span>SP Designs</span>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-xl-12 col-lg-12">
                                                <h4 style="margin-top:20px;">Project</h4>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-xl-12 col-lg-12">
                                                <span> </span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-xl-4 col-lg-4">
                                        <div class="row">
                                            <div class="col-xl-12 col-lg-12">
                                                <span>1</span>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-xl-12 col-lg-12">
                                                <h4 style="margin-top:20px;">Due Date</h4>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-xl-12 col-lg-12">
                                                <span> @quotation.DueDate.ToShortDateString()</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="row" style="margin-left:10px;margin-right:10px;">
                                    <div class="col-xl-12 col-lg-12">
                                        <hr />
                                    </div>
                                </div>
                                <div class="row" style="margin-left:10px;margin-bottom:10px;">
                                    <div class="col-xl-6 col-lg-6">
                                        <h3 style="color: rgb(127, 96, 0);">Description</h3>
                                    </div>
                                    <div class="col-xl-1 col-lg-1">
                                        <h3 style="color: rgb(127, 96, 0);">Qty</h3>
                                    </div>
                                    <div class="col-xl-2 col-lg-2">
                                        <h3 style="color: rgb(127, 96, 0);">Unit Price</h3>
                                    </div>
                                    <div class="col-xl-3 col-lg-3" style="padding-left:30px;">
                                        <h3 style="color: rgb(127, 96, 0);">Total Price</h3>
                                    </div>
                                </div>

                                @if (quotation != null && quotation.Rooms != null)
                                {
                                    @foreach (var room in quotation.Rooms)
                                    {
                                        @if (room != null && room.WorkOrders != null && room.WorkOrders.Count > 0)
                                        {
                                            @foreach (var workorder in room.WorkOrders)
                                            {
                                                <div class="row row-item">
                                                    <div class="col-xl-6 col-lg-6">
                                                        <span style="font-size:18px;">@workorder.Name</span>
                                                    </div>
                                                    <div class="col-xl-1 col-lg-1" style="text-align:center;">
                                                        <span>1 </span>
                                                    </div>
                                                    <div class="col-xl-2 col-lg-2" style="text-align:center;">
                                                        <span>₹ @GetUnitPrice(workorder).Result </span>
                                                    </div>
                                                    <div class="col-xl-3 col-lg-3" style="text-align:center;">
                                                        <span>₹ @workorder.TotalPrice.ToString("#,##0.00") </span>
                                                    </div>
                                                </div>

                                            }
                                        }
                                    }
                                }
                                <div class="row" style="margin-left:10px;margin-right:10px;">
                                    <div class="col-xl-12 col-lg-12">
                                        <hr />
                                    </div>
                                </div>
                                <div class="row" style="margin-left:10px;">
                                    <div class="col-xl-6 col-lg-6">
                                    </div>
                                    <div class="col-xl-3 col-lg-3">
                                        <span style="color:green;font-size:22px;">Total amount</span>
                                    </div>
                                    <div class="col-xl-3 col-lg-3">
                                        <span style="color:red;font-size:20px;padding-left:40px;">₹ @quotation.TotalAmount.ToString("#,##0.00") </span>
                                    </div>
                                </div>
                                <div class="row" style="margin-left:10px;">
                                    <div class="col-xl-5 col-lg-5">
                                        <span style="color:red;font-size:18px;">Notes:</span>
                                    </div>
                                </div>
                                <div class="row" style="margin-left:10px;margin-top:30px;margin-bottom:10px;">
                                    <div class="col-xl-12 col-lg-12">
                                        <h4>Commercial Terms & Conditions</h4>
                                    </div>
                                </div>
                                <div class="row" style="margin-left:10px;">
                                    <div class="col-xl-12 col-lg-12">
                                        <ul>
                                            <li>Once Designs are Finalized Changes Cannot be entertained.</li>
                                            <li>Payment 50% in advance, 40% against delivery of material and balance 10% after Completion.</li>
                                            <li>At the time of execution flat not handover from builder side or any work pending execution time will be late.</li>
                                            <li>Delivery time for wood work will be 35-45 days from the date of advance payment received.</li>
                                            <li>Wood work execution will take 25 to 35 days after completion of false ceiling.</li>
                                            <li>False ceiling, wall clading,wall paper laying will take 10-15 days from the date of advance received.</li>
                                        </ul>
                                    </div>
                                </div>
                                <div class="row" style="margin-left:10px;margin-top:10px;margin-bottom:10px;">
                                    <div class="col-xl-12 col-lg-12">
                                        <h4>Materials Used</h4>
                                    </div>
                                </div>
                                @if (quotation != null && quotation.MaterialsUsed != null)
                                {
                                    @foreach (var material in quotation.MaterialsUsed)
                                    {

                                        <div class="row" style="margin-left:10px;">
                                            <div class="col-xl-2 col-lg-2">
                                                <span style="padding-left:10px; font-size:18px;">@material.Name :</span>
                                            </div>
                                            <div class="col-xl-10 col-lg-10">
                                                <span style="font-size:18px;">@material.Type</span>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        </div>

                    </div>
                </div>
            </div>

        </div>
    </div>

    <div id="preloader" style="display: @(showLoader ? "block" : "none")">
        <div id="preloader-status" style="background-image: url('images/icon/preeloader.gif')"></div>
    </div>

}
