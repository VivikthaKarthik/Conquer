@page "/room/add/{projectId}"
@page "/room/edit/{projectId}/{id}"
@using SPInteriors.Models
@using SPInteriors.Services.Interfaces
@rendermode InteractiveServer
<div class="grid-area style-1 scrollable-area" style="background-image: url(./images/contact/subscribe-bg.jpg)">
    <div class="container edit-screen-container">
        <div class="row edit-screen-header">
            <div class="col-xl-12">
                <h3>Room</h3>
            </div>
        </div>

        <div class="row">
            <div class="col-xl-12 col-lg-12">
                <div class="subscribe-form-widget">
                    <form>
                        <div class="row form-row">
                            <div class="faq-area">
                                <div class="container">

                                    <div class="row form-row">
                                        <div class="col-xl-2 col-lg-2">
                                            <div class="form-label">
                                                Name
                                            </div>
                                        </div>
                                        <div class="col-xl-4 col-lg-4">
                                            <div class="form-field">
                                                <input type="text" class="form-control" @bind-value="@room.Name" placeholder="Enter Name" />
                                            </div>
                                        </div>

                                        <div class="col-xl-2 col-lg-2">
                                            <div class="form-label">
                                                Project
                                            </div>
                                        </div>
                                        <div class="col-xl-4 col-lg-4">
                                            <div class="form-field">
                                                <input type="text" class="form-control" value="@room.ProjectName" placeholder="Enter Name" readonly />
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row form-row">

                                        <div class="col-xl-2 col-lg-2">
                                            <div class="form-label">
                                                Material Type
                                            </div>
                                        </div>
                                        <div class="col-xl-4 col-lg-4">
                                            <div class="form-field">
                                                <Dropdown ControlId="MaterialTypeId" TableName="MaterialType" ExistingItem="@room.MaterialTypeId" OnItemSelection='((value) => room.MaterialTypeId = value.Id)'></Dropdown>
                                            </div>
                                        </div>

                                        <div class="col-xl-2 col-lg-2">
                                            <div class="form-label">
                                                Outer Frame
                                            </div>
                                        </div>
                                        <div class="col-xl-4 col-lg-4">
                                            <div class="form-field">
                                                <Dropdown ControlId="OuterFrameTypeId" TableName="OuterFrameType" ExistingItem="@room.OuterFrameTypeId" OnItemSelection='((value) => room.OuterFrameTypeId = value.Id)'></Dropdown>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row" style="padding-left:10px;padding-top:47px;">
                                        <div class="col-xl-6">
                                            <h4>Work Orders</h4>
                                        </div>
                                        <div class="col-xl-6 grid-buttons-container" style="display:block">
                                            <button class="myButton text-right" @onclick='(() => AddWorkOrder(room.Id))' type="button">Add <i class="fa-solid fa-add"></i></button>
                                        </div>
                                    </div>
                                    <div class="our-team-area style-2">


                                        <div class="container">

                                            <div class="team-card-wrapper">
                                                <div class="row">
                                                    @if (room.Services != null && room.Services.Count > 0)
                                                    {
                                                        @foreach (var service in room.Services)
                                                        {
                                                            <div class="col-lg-3 col-md-5" style="margin-top:20px;" @onclick='(() => EditService(service.Id, room.Id))'>
                                                                <div class="team-member-card">
                                                                    <div class="content-wrapper">
                                                                        <div class="content">
                                                                            <h2 class="title">@service.Name</h2>
                                                                            <p class="desc">@service.WorkOrderItem</p>
                                                                        </div>
                                                                    </div>
                                                                    <div class="image">
                                                                        @if (!string.IsNullOrEmpty(service.ImagePath))
                                                                        {
                                                                            <img style="height:300px;width:100%;" src="@service.ImagePath" />
                                                                        }
                                                                        else
                                                                        {
                                                                            <img src="images/room/livingroom/livingroom.jpg" />
                                                                        }
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        }
                                                    }
                                                </div>
                                            </div>
                                        </div>

                                    </div>


                                </div>
                            </div>
                        </div>

                        <div class="row form-row">
                            <div class="col-xl-12 grid-buttons-container">
                                <button class="myButton text-right" @onclick="OnBackClicked" type="button">Back</button>
                                <button class="myButton text-right" @onclick="SaveAndRedirect" type="button">Save</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>


