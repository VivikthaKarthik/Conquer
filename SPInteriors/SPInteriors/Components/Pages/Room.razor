<!-- Scroll Up Section Start -->
<div id="scrollTop" class="scrollup-wrapper">
    <div class="scrollup-btn">
        <i class="fa-regular fa-angle-up"></i>
    </div>
</div>
<!-- Scroll Up Section End -->

@code {
    @inject IJSRuntime JSRuntime;
    @inject NavigationManager NavigationManager;
    @inject IRoomService roomService;
    @inject IProjectService projectService;

    [Parameter]
    public string id { get; set; } = "0";

    [Parameter]
    public string projectId { get; set; }

    bool isAdd { get; set; }

    public RoomDto room { get; set; }
    public ProjectDto project { get; set; }


    protected async override void OnInitialized()
    {
        if (!string.IsNullOrEmpty(id))
        {
            isAdd = false;
            room = await roomService.GetRoomListByIdAsync(Convert.ToInt32(id));
        }
        else
        {
            room = new RoomDto();
            isAdd = true;
        }
        if (projectId != null && Convert.ToInt32(projectId) > 0)
        {
            project = await projectService.GetProjectByIdAsync(Convert.ToInt32(projectId));

            if (project != null)
            {
                room.ProjectId = project.Id;
                room.ProjectName = project.Name;

                if (room.MaterialTypeId == 0)
                    room.MaterialTypeId = project.MaterialId;

                if (room.OuterFrameTypeId == 0)
                    room.OuterFrameTypeId = project.OuterFrameId;
            }
        }

    }


    private async Task AddWorkOrder(int roomId)
    {
        NavigationManager.NavigateTo("workorder/add/" + roomId, false);
    }

    private async Task EditWorkOrder(int serviceId, int roomId)
    {
        NavigationManager.NavigateTo("workorder/edit/" + roomId + "/" + serviceId, false);
    }

    private async Task AddNewService()
    {
        NavigationManager.NavigateTo("service", false);
    }


    private async Task OnBackClicked()
    {
        NavigationManager.NavigateTo("projects/edit/" + projectId, false);
    }

    private async Task<bool> SaveRoom()
    {
        if (string.IsNullOrEmpty(room.Name))
        {
            await JSRuntime.InvokeVoidAsync("ShowAlert", "Please Add all required fields");
            return false;
        }
        else
        {
            await roomService.CreateRoomAsync(room);
            return true;
        }
    }

    private async Task SaveAndRedirect()
    {
        if (await SaveRoom())
        {
            NavigationManager.NavigateTo("projects/edit/" + projectId, false);
        }
    }


    private async Task EditService(int serviceId, int roomId)
    {
        NavigationManager.NavigateTo("workorder/edit/" + roomId + "/" + serviceId, false);
    }
}


