@using SPInteriors.Models
@using SPInteriors.Services.Interfaces

@if (isDataFetchedCompletely)
{
    <div class="modal @ModalClass" tabindex="-1" style="display: @(ShowModal ? "block" : "none")">
        <div class="modal-dialog">
            <div class="modal-content" style="width:800px;max-height:600px;position:center;">
                <div class="modal-header">
                    <h3 class="modal-title">Part Details</h3>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CloseModal" style="color:#ffff;"></button>
                </div>
                <div class="modal-body" id="modalBodyTemplate" style="height:100%;width:100%;overflow-y:scroll;overflow:auto;">

                    <div class="contact-form-area style-3 py-30 py-sm-60 py-md-80 py-lg-100">
                        <!-- Submit form Start -->
                        <div class="container">
                            <div class="contact-form-inner">
                                <div class="row justify-content-center">
                                    <div class="col-lg-12">
                                        <!-- Comment Form Start -->
                                        <div class="comment-respond">
                                            <div class="row gx-2">
                                                <div class="col-xl-12">
                                                    <div class="contacts-name">
                                                        <h4>@WorkOrderItemName</h4>
                                                    </div>
                                                </div>
                                                <div class="col-xl-6">
                                                    <div class="contacts-email">
                                                        <span style="font-size:16px;padding-left:4px;">Height</span>
                                                        <input name="website" type="number" @bind-value="height">
                                                    </div>
                                                </div>
                                                <div class="col-xl-6">
                                                    <div class="contacts-name">
                                                        <span style="font-size:16px;padding-left:4px;">Width</span>
                                                        <input name="website" type="number" @bind-value="width">
                                                    </div>
                                                </div>
                                                <div class="col-xl-12">
                                                    <div class="contacts-message">
                                                        <span style="font-size:16px;padding-left:4px;">Notes</span>
                                                        <textarea name="comment" cols="20" rows="3" ></textarea>
                                                    </div>
                                                </div>
                                                <div class="col-xl-12" style="margin-bottom:10px;">
                                                    <h4>Properties</h4>
                                                </div>

                                                @if (WorkOrderTypes != null && WorkOrderTypes.Count > 0)
                                                {
                                                    <div class="col-xl-12" style="margin-left:5px;margin-right:5px; margin-bottom:20px;border: 1px solid lightgrey;background-color:#ffffff;">
                                                        <div class="grid-item-header">
                                                            <h3>Type</h3>
                                                        </div>

                                                        <div class="grid-item-content">
                                                            @foreach (var type in WorkOrderTypes)
                                                            {
                                                                <div class="grid-item @(type.Id == part.WorkOrderTypeId ? "grid-item-selected" : "")"
                                                                     id='@(type.Name.Replace(" ", "") + '_' + type.Id.ToString())' @onclick='(() => SelectWorkOrderType(type.Id, type.Name))'>
                                                                    @type.Name
                                                                </div>
                                                            }
                                                            <div class="grid-item">
                                                                Add New
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                                @foreach (var item in Properties)
                                                {
                                                    @if (item.Fields != null && item.Fields.Count > 0)
                                                    {
                                                        <div class="col-xl-12" style="margin-left:5px;margin-right:5px; margin-bottom:20px;border: 1px solid lightgrey;background-color:#ffffff;">
                                                            <div class="grid-item-header">
                                                                <h3>@item.Name</h3>
                                                            </div>
                                                            <div class="grid-item-content">
                                                                @foreach (var field in item.Fields)
                                                                {
                                                                    <div class="grid-item @(part.Details != null && part.Details.Any(x => x.Name == item.Name && x.Value == field.Name) ? "grid-item-selected" : "")"
                                                                         id='@(item.Name.Replace(" ", "") + '_' + field.Id.ToString())' @onclick='(() => SelectProperty(item.Id, field.Id, item.Name,  field.Name))'>
                                                                        @field.Name
                                                                    </div>
                                                                }
                                                                <div class="grid-item" id='@(item.Name.Replace(" ", "") + "_Other")' @onclick='(() => SelectProperty(item.Id, 0, "", ""))'>
                                                                    Add New
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }
                                                }
                                            </div>
                                        </div>
                                        <!-- Comment Form End -->
                                    </div>
                                    <div class="col-12">
                                        <div class="row form-row">
                                            <div class="col-xl-12 grid-buttons-container">
                                                <button class="myButton text-right" @onclick="OnBackClicked" type="button">Close</button>
                                                <button class="myButton text-right" @onclick="OnSaveClicked" type="button">Save</button>
                                                @if (RequestType == "Edit")
                                                {
                                                    <button class="myButton text-right" @onclick="DeletePart" type="button">Delete</button>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- Submit form End -->
                    </div>

                </div>
            </div>
        </div>
    </div>
}
@code {
    @inject IJSRuntime JSRuntime;
    @inject NavigationManager NavigationManager;
    @inject IWorkOrderService workOrderService;
    @inject ICommonService commonService;

    [Parameter] public bool ShowModal { get; set; }
    [Parameter] public EventCallback<bool> ShowModalChanged { get; set; }
    private string ModalClass => ShowModal ? "show" : "";

    [Parameter]
    public int partId { get; set; }

    [Parameter]
    public int workOrderId { get; set; }

    [Parameter]
    public string RequestType { get; set; }

    WorkOrderPartDto part { get; set; }
    bool isDataFetchedCompletely = false;

    string src { get; set; }

    string WorkOrderItemName { get; set; }

    string height { get; set; }

    string width { get; set; }

    List<WorkOrderPropertyDto> Properties { get; set; }

    List<ListItemDto> WorkOrderTypes { get; set; }

    private async Task CloseModal()
    {
        await JSRuntime.InvokeVoidAsync("UnselectAll");
        ShowModal = false;
        await ShowModalChanged.InvokeAsync(ShowModal);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (ShowModal)
        {
            await FetchData();
        }
    }


    protected async override void OnInitialized()
    {
        if (ShowModal)
        {
            await FetchData();
        }
    }

    private async Task OnBackClicked()
    {
        await CloseModal();
    }


    private async Task OnSaveClicked()
    {
        bool isSuccess = false;
        string errorMessage = await Validate();
        if (string.IsNullOrEmpty(errorMessage))
        {
            part.Height = Convert.ToDecimal(height);
            part.Width = Convert.ToDecimal(width);
            if (RequestType == "Add")
                isSuccess = await workOrderService.CreateWorkOrderPartAsync(part, Properties);
            else
                isSuccess = await workOrderService.UpdateWorkOrderPartAsync(part, Properties);

            await CloseModal();
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("ShowAlert", errorMessage);
        }
    }


    private async Task<string> Validate()
    {
        string errorMessage = string.Empty;

         if (part.WorkOrderTypeId <= 0)
        {
            errorMessage = "Please Select WorkOrder Type";
        }
        else if (string.IsNullOrEmpty(height) || string.IsNullOrEmpty(width))
        {
            errorMessage = "Plese Enter Measurements";
        }

        return errorMessage;
    }

    private async Task FetchData()
    {
        if (ShowModal)
        {
            if (RequestType == "Edit")
            {
                if (partId > 0)
                {
                    part = await workOrderService.GetWorkOrderPartsAsync(partId);
                    height = part.Height.ToString();
                    width = part.Width.ToString();
                }
                else
                {
                    await JSRuntime.InvokeVoidAsync("ShowAlert", "Part Id is missing. Please try again...");
                    await CloseModal();
                }
            }
            else
            {
                height = string.Empty;
                width = string.Empty;
                part = new WorkOrderPartDto();
                if (workOrderId > 0)
                {
                    part.WorkOrderId = workOrderId;
                    part.WorkOrder = await workOrderService.GetWorkOrderAsync(workOrderId);
                }
                else
                {
                    await JSRuntime.InvokeVoidAsync("ShowAlert", "Workorder Id is missing. Please try again...");
                    await CloseModal();
                }
            }

            WorkOrderItemName = part.WorkOrder.Name;

            if (!string.IsNullOrEmpty(part.WorkOrderType))
            {
                WorkOrderItemName += " - " + part.WorkOrderType;
            }
            WorkOrderTypes = await commonService.GetListItems("WorkOrderType", "", null);
            Properties = await workOrderService.GetWorkOrderPropertiesAsync();
        }
        isDataFetchedCompletely = true;
    }

    private async Task DeletePart()
    {
        if(partId > 0)
        {            
            var result = await workOrderService.DeleteWorkOrderPart(partId);

            if (result)
            {
                await JSRuntime.InvokeVoidAsync("ShowAlert", "Deleted " + WorkOrderItemName + " successfully !");
                await CloseModal();
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("ShowAlert", "Some error occured. Please try again !");
            }
        }
    }

    private async Task SelectWorkOrderType(int selectedWorkOrderTypeId, string selectedWorkOrderType)
    {
        if (selectedWorkOrderTypeId > 0)
        {
            string elementId = selectedWorkOrderType.Replace(" ", "") + "_" + selectedWorkOrderTypeId.ToString();
            var type = WorkOrderTypes.First(x => x.Id == selectedWorkOrderTypeId);

            if (part.WorkOrderTypeId == selectedWorkOrderTypeId)
            {
                part.WorkOrderTypeId = 0;
                await JSRuntime.InvokeVoidAsync("DeselectItem", elementId);
            }
            else
            {
                foreach (var item in WorkOrderTypes)
                {
                    part.WorkOrderTypeId = 0;
                    await JSRuntime.InvokeVoidAsync("DeselectItem", elementId);
                }

                part.WorkOrderTypeId = selectedWorkOrderTypeId;
                await JSRuntime.InvokeVoidAsync("SelectItem", elementId);
            }
        }
    }


    private async Task SelectProperty(int propertyId, int fieldId, string name, string value)
    {
        if (fieldId > 0)
        {
            string elementId = string.Empty;
            var property = Properties.First(x => x.Id == propertyId);

            if (property != null)
            {
                if (!property.AllowMultipleSelect)
                {
                    if (property.Fields != null && property.Fields.Count > 0)
                    {
                        foreach (var item in property.Fields)
                        {
                            elementId = property.Name.Replace(" ", "") + "_" + item.Id.ToString();
                            if (item.Id == fieldId)
                            {
                                if (property.SelectedValues.Any(x => x.Value == item.Name && x.Name == name))
                                {
                                    var SelectedItem = property.SelectedValues.First(x => x.Value == item.Name && x.Name == name);
                                    property.SelectedValues.Remove(SelectedItem);
                                    await JSRuntime.InvokeVoidAsync("DeselectItem", elementId);
                                }
                                else
                                {
                                    WorkOrderDetailsDto selectedItem = new WorkOrderDetailsDto();
                                    selectedItem.Name = name;
                                    selectedItem.Value = value;
                                    property.SelectedValues.Add(selectedItem);
                                    await JSRuntime.InvokeVoidAsync("SelectItem", elementId);
                                }
                            }
                            else
                            {
                                if (property.SelectedValues.Any(x => x.Value == item.Name && x.Name == name))
                                {
                                    var SelectedItem = property.SelectedValues.First(x => x.Value == item.Name && x.Name == name);
                                    if (SelectedItem != null)
                                        property.SelectedValues.Remove(SelectedItem);
                                }
                                await JSRuntime.InvokeVoidAsync("DeselectItem", elementId);
                            }
                        }
                    }
                }
                else
                {
                    elementId = property.Name.Replace(" ", "") + "_" + fieldId.ToString();
                    if (property.SelectedValues.Any(x => x.Value == value && x.Name == name))
                    {
                        var SelectedItem = property.SelectedValues.First(x => x.Value == value && x.Name == name);
                        if (SelectedItem != null)
                            property.SelectedValues.Remove(SelectedItem);

                        await JSRuntime.InvokeVoidAsync("DeselectItem", elementId);
                    }
                    else
                    {
                        WorkOrderDetailsDto selectedItem = new WorkOrderDetailsDto();
                        selectedItem.Name = name;
                        selectedItem.Value = value;
                        property.SelectedValues.Add(selectedItem);
                        await JSRuntime.InvokeVoidAsync("SelectItem", elementId);
                    }
                }
            }
        }
    }

}
