@page "/projects"
@using SPInteriors.Models
@using SPInteriors.Services.Interfaces
@rendermode @(new InteractiveServerRenderMode(prerender:false))

<div class="grid-area style-1 scrollable-area" style="background-image: url(./images/contact/subscribe-bg.jpg)">
    <div class="container">
        <div class="row">

            <!-- Latest Posts Area Start style-3 -->
            <div class="latest-posts-area style-2 py-40" style="margin-top:10px">
                <div class="container">
                    <div class="section-title">
                        <div class="sec-content">
                            <div class="short-title-wrapper">
                                <span class="short-title only-divider">Projects</span>
                            </div>
                            <h2 class="title">
                                Designing Spaces for Every <br>
                                Taste and Budget
                            </h2>
                        </div>
                        <div class="sec-desc">
                            @*    <div class="short-title-wrapper">
                            <label class="switch">
                            Slider <input type="checkbox" checked>
                            <span class="slider round"> Slider </span>
                            </label>
                            </div> *@
                            <div class="slider-nav-btn-wrapper">
                                <a href="#" class="slider-nav-prev-btn" id="post_slider_prev_btn"><i class="fa-solid fa-arrow-left"></i></a>
                                <a href="#" class="slider-nav-next-btn" id="post_slider_next_btn">
                                    <i class="fa-solid fa-arrow-right"></i>
                                </a>
                            </div>
                        </div>
                    </div>

                    <div class="row" style="margin-bottom:20px;">
                        <div class="col-xl-3">
                            <input class="search-field" name="clientSearch" type="text" @bind-value="clientName" placeholder="Enter Client Name">
                        </div>
                        <div class="col-xl-3">
                            <select id="projectStatus" name="dropdownControl" class="form-control" asp-for="DropdownProperty" @bind="@statusId">
                                <option value="0">Select</option>
                                <option value="1">New</option>
                                <option value="2">Accepted</option>
                                <option value="3">Work  In Progress</option>
                                <option value="4">Completed</option>
                                <option value="5">Cancelled</option>
                            </select>
                        </div>
                        <div class="col-xl-3">
                            <button class="myButton" @onclick="SearchProjects" type="button">Search</button>
                        </div>
                        <div class="col-xl-3 grid-buttons-container">
                            <button class="myButton text-right" @onclick="AddProject" type="button">New</button>
                        </div>
                    </div>
                    <div class="our-team-area style-2">
                        <div class="container">
                            <div class="team-card-wrapper">
                                <div class="row">
                                    @if (projects != null && projects.Count > 0)
                                    {
                                        @foreach (var item in projects)
                                        {
                                            <div class="col-lg-3 col-md-5" style="margin-top:20px;" @onclick='(() => EditProject(item.Id))'>
                                                <div class="team-member-card">
                                                    <div class="content-wrapper">
                                                        <div class="content">
                                                            <h2 class="title">@item.Name</h2>
                                                            <p class="desc" style="padding: 0 40px;">@item.Status</p>
                                                        </div>
                                                    </div>
                                                    <div class="image">
                                                        @if (!string.IsNullOrEmpty(item.ImagePath))
                                                        {
                                                            <img style="height:300px;width:100%;" src="@item.ImagePath" />
                                                        }
                                                        else
                                                        {
                                                            <img src="images/room/livingroom/livingroom.jpg" />
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        </div>

                    </div>


                </div>
            </div>
            <!-- Latest Posts Area End style-3 -->
        </div>


    </div>
</div>

